# Copy to .env and adjust. NEVER commit a real .env.
# Nothing here is a secret today -- every target is LOCAL: an in-memory mock, a
# Playwright browser driving the committed local page, or an in-process simulator
# of an external REST service. Real credentials would belong in a secrets manager,
# not in this file.

# Target application. Defaults to the committed local prototype page.
# Production would point at the real HR system -- which this project has never done.
HR_BASE_URL=file:///absolute/path/to/reports/day3/hr_payroll_mock_app.html

# Browser adapter
BROWSER_HEADLESS=1
AUTOMATION_TIMEOUT_MS=5000

# Automation API
API_HOST=127.0.0.1
API_PORT=8000

# --- Day-5 integration boundary -------------------------------------------

# Development authentication only. Production requires an enterprise identity
# provider (Entra ID, Okta, or whatever the customer environment mandates)
# issuing verified tokens whose claims map to these roles.
#
# 0 = a request with no Authorization header resolves to a default local
#     principal, so the demo runs without credential setup.
# 1 = fail closed; every request must authenticate. This is what a deployment
#     would set.
API_AUTH_REQUIRED=0

# Role used for unauthenticated local requests when API_AUTH_REQUIRED=0.
# `reviewer` deliberately: it can prepare and confirm so the demo works, but it
# cannot read the audit trail -- so the permission boundary stays observable.
# One of: operator | reviewer | admin
API_DEFAULT_ROLE=reviewer

# CORS. Local development origins only, comma-separated. This is NOT a production
# CORS configuration: a deployment requires an explicit allowlist of the real
# deployed frontend origins.
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Execution state persistence. Unset = in-memory (process-local, lost on restart).
# Set a path to use the SQLite repository instead, so an execution whose outcome is
# UNKNOWN survives a restart and can still be resolved.
# Note content, credentials and tokens are never written, whatever this is set to.
EXECUTION_DB_PATH=

# Audit trail. Unset = in-memory only. Set a path to persist as JSONL.
# Note content and credentials are never written, whatever this is set to.
AUTOMATION_AUDIT_LOG=

# --- Local HTTP integration (integration_mode=http) --------------------------

# The separate LOCAL HR API simulator: python scripts/serve_local_hr_api.py
# It is a local simulator of an HR system -- not a real HR system, not a deployment.
HR_API_BASE_URL=http://127.0.0.1:8100

# Per-call client timeout, in seconds. A confirmation that times out is reported
# UNKNOWN and settled by a status lookup -- it is never retried.
HR_API_TIMEOUT_S=3

# SQLite file for the simulator's state (executions, audit). Never holds note text.
LOCAL_HR_DB_PATH=local_hr_system.db

# Development service credential shared by the adapter and the simulator.
# Unset = a local default that protects nothing. This is NOT enterprise
# authentication: production needs a real service identity, a secrets manager,
# rotation and an auditable caller identity.
LOCAL_HR_API_TOKEN=

LOG_LEVEL=INFO
